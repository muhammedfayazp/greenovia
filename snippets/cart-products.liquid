{% liquid
  assign block_settings = block.settings
%}

<script
  src="{{ 'component-cart-items.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>
<script
  src="{{ 'component-cart-quantity-selector.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

<div
  {{ block.shopify_attributes }}
  class="modern-cart-wrapper"
  {% if settings.product_title_case == 'uppercase' %}
    style="--product-title-case: uppercase;"
  {% endif %}
>
  {% if cart.empty? %}
    {%- comment -%} Empty State {%- endcomment -%}
    <div class="cart-empty-state">
      <div class="cart-empty-backdrop"></div>

      <div class="cart-empty-icon-wrapper">
        <div class="cart-empty-icon-circle">
          <svg width="52" height="52" viewBox="0 0 48 48" fill="none" class="cart-empty-icon-svg">
            <path d="M8 16L6 20V38C6 39.1 6.9 40 8 40H40C41.1 40 42 39.1 42 38V20L40 16H8Z" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M16 16V10C16 7.8 17.8 6 20 6H28C30.2 6 32 7.8 32 10V16" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
            <circle cx="24" cy="28" r="1.2" fill="currentColor"/>
          </svg>
        </div>
      </div>

      <div class="cart-empty-content">
        <h1 class="cart-empty-heading">Your cart is empty</h1>
        <p class="cart-empty-text">Discover beautiful items and start building your collection today.</p>

        <div class="cart-empty-actions">
          <a
            class="cart-empty-button cart-empty-button--primary"
            href="{{ settings.empty_cart_button_link | default: routes.all_products_collection_url }}"
          >
            Continue Shopping
          </a>
          <a
            class="cart-empty-button cart-empty-button--secondary"
            href="{{ routes.root_url }}"
          >
            Return Home
          </a>
        </div>
      </div>

      <div class="cart-empty-decoration">
        <div class="cart-empty-decoration-item cart-empty-decoration-item--1"></div>
        <div class="cart-empty-decoration-item cart-empty-decoration-item--2"></div>
        <div class="cart-empty-decoration-item cart-empty-decoration-item--3"></div>
      </div>
    </div>
  {%- else -%}
    {%- comment -%} Cart Items {%- endcomment -%}
    <span class="visually-hidden" ref="cartItemCount" aria-hidden="true">{{- cart.item_count -}}</span>

    <form
      action="{{ routes.cart_url }}"
      class="modern-cart-form"
      id="cart-form"
      method="post"
    >
      <div class="modern-cart-items" id="cart-items-container">
        {% for item in cart.items %}
          <div
            class="cart-item"
            ref="cartItemRows[]"
            data-parent-key="{{ item.parent_relationship.parent.key }}"
            data-key="{{ item.key }}"
            data-line-index="{{ item.index }}"
          >
            {%- comment -%} Product Image {%- endcomment -%}
            <div class="cart-item__image-wrapper">
              <a href="{{ item.url }}" class="cart-item__image-link">
                {% if item.image %}
                  <img
                    src="{{ item.image | image_url: width: 200 }}"
                    alt="{{ item.product.title | escape }}"
                    class="cart-item__img"
                    loading="lazy"
                  />
                {% else %}
                  <div class="cart-item__image-placeholder">
                    <svg viewBox="0 0 100 100" fill="none">
                      <rect width="100" height="100" fill="#f8f8f8"/>
                      <path d="M30 40L50 60L70 40M50 30V70" stroke="#d0d0d0" stroke-width="2"/>
                    </svg>
                  </div>
                {% endif %}
              </a>
            </div>

            {%- comment -%} Product Details {%- endcomment -%}
            <div class="cart-item__main">
              <div class="cart-item__header">
                <div class="cart-item__info">
                  <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title }}</a>

                  {%- comment -%} Variants {%- endcomment -%}
                  {% if item.product.has_only_default_variant == false %}
                    <div class="cart-item__variants">
                      {% for option in item.options_with_values %}
                        <span class="cart-item__variant-item">{{ option.value }}</span>
                      {% endfor %}
                    </div>
                  {% endif %}
                </div>
                <div class="cart-item__price-main"><span class="dirham-symbol" aria-hidden="true">&#xE000;</span>{{ item.price | money_without_currency }}</div>
              </div>

              {%- comment -%}
                Controls Row.

                The quantity control is the theme's shared quantity-selector snippet (the same
                one CartItemsComponent's JS is built to talk to via QuantitySelectorUpdateEvent),
                and the remove button calls CartItemsComponent's own onLineItemRemove method
                directly through the on:click action attribute. Both go through the same queued
                /cart/change.js flow and DOM morph as every other cart mutation in the theme, so
                this row can't fall out of sync with the server the way a separate hand-rolled
                fetch (bypassing that flow) previously could.
              {%- endcomment -%}
              <div class="cart-item__footer">
                <div class="cart-item__quantity-group">
                  {% render 'quantity-selector',
                    product: item.product,
                    variant: item.variant,
                    in_cart_quantity: item.quantity,
                    line_index: item.index,
                    class: 'cart-item__quantity'
                  %}
                </div>

                <div class="cart-item__line-total"><span class="dirham-symbol" aria-hidden="true">&#xE000;</span>{{ item.final_line_price | money_without_currency }}</div>

                <button
                  type="button"
                  class="cart-item__remove"
                  on:click="/onLineItemRemove/{{ item.index | plus: 1 }}"
                  aria-label="Remove {{ item.product.title | escape }}"
                  title="Remove from cart"
                >
                  <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
                    <path d="M3 5h12M7 8v4M11 8v4M4 5l1 9a1 1 0 001 1h6a1 1 0 001-1l1-9M7 5V3.5A.5.5 0 017.5 3h3a.5.5 0 01.5.5V5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </button>
              </div>

              {%- comment -%} Error Message {%- endcomment -%}
              <div
                class="cart-item__error hidden"
                ref="cartItemErrorContainer-{{ item.index | plus: 1 }}"
              >
                <span class="cart-item__error-text" ref="cartItemError-{{ item.index | plus: 1 }}"></span>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    </form>
  {%- endif -%}
</div>

<style>
/* ==========================================
   ENHANCED CART DESIGN - REFINED & PREMIUM
   ========================================== */

@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Outfit:wght@400;500;600;700&display=swap');

:root {
  --cart-primary: #1a5c3a;
  --cart-primary-hover: #174F19;
  --cart-primary-light: #e6f2eb;
  --cart-text-primary: #0f0f0f;
  --cart-text-secondary: #5a5a5a;
  --cart-text-tertiary: #888888;
  --cart-border: #e8eaed;
  --cart-bg: #ffffff;
  --cart-bg-hover: #ffffff;
  --cart-red: #d32f2f;
  --cart-red-light: #ffebee;
  --cart-shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.04);
  --cart-shadow-md: 0 4px 16px rgba(0, 0, 0, 0.08);
}

.modern-cart-wrapper {
  width: 100%;
  padding: 0;
  font-family: 'Outfit', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  color: var(--cart-text-primary);
}

/* ==========================================
   PERFECT EMPTY STATE - REFINED
   ========================================== */

.cart-empty-state {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 4rem 2rem 5rem;
  text-align: center;
  min-height: 500px;
  background: #ffffff;
  border-radius: 12px;
  overflow: hidden;
  margin: 1.5rem;
}

.cart-empty-backdrop {
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at 30% 50%, rgba(26, 92, 58, 0.03) 0%, transparent 50%),
              radial-gradient(circle at 70% 80%, rgba(26, 92, 58, 0.02) 0%, transparent 50%);
  pointer-events: none;
}

.cart-empty-decoration {
  position: absolute;
  inset: 0;
  overflow: hidden;
  pointer-events: none;
}

.cart-empty-decoration-item {
  position: absolute;
  border-radius: 50%;
  opacity: 0.04;
}

.cart-empty-decoration-item--1 {
  width: 300px;
  height: 300px;
  background: var(--cart-primary);
  top: -100px;
  right: -100px;
  animation: float 6s ease-in-out infinite;
}

.cart-empty-decoration-item--2 {
  width: 200px;
  height: 200px;
  background: var(--cart-primary);
  bottom: -50px;
  left: -50px;
  animation: float 8s ease-in-out infinite 1s;
}

.cart-empty-decoration-item--3 {
  width: 150px;
  height: 150px;
  background: var(--cart-primary);
  top: 50%;
  left: 10%;
  animation: float 7s ease-in-out infinite 2s;
}

@keyframes float {
  0%, 100% { transform: translateY(0px); }
  50% { transform: translateY(20px); }
}

.cart-empty-icon-wrapper {
  position: relative;
  z-index: 2;
  margin-bottom: 2.5rem;
  animation: fadeInDown 0.6s ease-out forwards;
}

@keyframes fadeInDown {
  from {
    opacity: 0;
    transform: translateY(-20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.cart-empty-icon-circle {
  width: 130px;
  height: 130px;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(230, 242, 235, 0.8) 0%, rgba(230, 242, 235, 0.4) 100%);
  border: 2px solid rgba(26, 92, 58, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  position: relative;
  box-shadow: 0 8px 24px rgba(26, 92, 58, 0.08);
}

.cart-empty-icon-svg {
  color: var(--cart-primary);
  display: block;
  width: 52px;
  height: 52px;
  filter: drop-shadow(0 2px 4px rgba(26, 92, 58, 0.1));
}

.cart-empty-content {
  position: relative;
  z-index: 2;
  max-width: 480px;
  animation: fadeInUp 0.6s ease-out 0.2s forwards;
  opacity: 0;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.cart-empty-heading {
  font-family: 'Playfair Display', serif;
  font-size: 2.25rem;
  font-weight: 700;
  color: var(--cart-text-primary);
  margin: 0 0 1rem 0;
  letter-spacing: -0.02em;
  line-height: 1.2;
}

.cart-empty-text {
  font-size: 1rem;
  color: var(--cart-text-secondary);
  margin: 0 0 2.5rem 0;
  line-height: 1.6;
  font-weight: 400;
}

.cart-empty-actions {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  margin-top: 2.5rem;
}

.cart-empty-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0.95rem 2.5rem;
  font-size: 0.95rem;
  font-weight: 600;
  border: none;
  border-radius: 8px;
  text-decoration: none;
  cursor: pointer;
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  letter-spacing: -0.01em;
  position: relative;
  overflow: hidden;
}

.cart-empty-button::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(255,255,255,0.1) 0%, transparent 100%);
  pointer-events: none;
}

.cart-empty-button--primary {
  background: linear-gradient(135deg, var(--cart-primary) 0%, #0f5038 100%);
  color: white;
  box-shadow: 0 4px 15px rgba(26, 92, 58, 0.25);
}

.cart-empty-button--primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(26, 92, 58, 0.35);
}

.cart-empty-button--primary:active {
  transform: translateY(0);
}

.cart-empty-button--secondary {
  background: white;
  color: var(--cart-primary);
  border: 2px solid var(--cart-border);
}

.cart-empty-button--secondary:hover {
  border-color: var(--cart-primary);
  background: var(--cart-primary-light);
  transform: translateY(-1px);
}

/* ==========================================
   FILLED CART - HEADER & ITEMS
   ========================================== */

.modern-cart-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1.5rem 1rem;
  border-bottom: 1px solid var(--cart-border);
  background: #ffffff;
}

.modern-cart-title {
  font-family: 'Playfair Display', serif;
  font-size: 1.75rem;
  font-weight: 700;
  color: var(--cart-text-primary);
  margin: 0;
  letter-spacing: -0.02em;
}

.modern-cart-count {
  font-size: 0.875rem;
  color: var(--cart-text-secondary);
  font-weight: 500;
  background: var(--cart-primary-light);
  padding: 0.4rem 0.8rem;
  border-radius: 20px;
}

.modern-cart-items {
  display: flex;
  flex-direction: column;
  gap: 0;
}

/* ==========================================
   CART ITEM - PREMIUM LAYOUT
   ========================================== */

.cart-item {
  display: flex;
  gap: 0.875rem;
  padding: 1rem;
  background: var(--cart-bg);
  border-bottom: 1px solid var(--cart-border);
  transition: background 0.2s ease;
  position: relative;
  align-items: flex-start;
}

.cart-item:hover {
  background: var(--cart-bg-hover);
}

.cart-item:last-child {
  border-bottom: none;
}

/* ==========================================
   PRODUCT IMAGE
   ========================================== */

.cart-item__image-wrapper {
  width: 80px;
  height: 80px;
  flex-shrink: 0;
}

.cart-item__image-link {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: 10px;
  overflow: hidden;
  background: #f7f7f7;
  border: 1px solid #ebebeb;
  transition: border-color 0.2s ease;
  position: relative;
  padding: 6px;
}

.cart-item__image-link:hover {
  border-color: var(--cart-primary);
  box-shadow: var(--cart-shadow-sm);
}

.cart-item__img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  display: block;
}

.cart-item__image-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--cart-bg-hover);
}

/* ==========================================
   PRODUCT DETAILS
   ========================================== */

.cart-item__main {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  min-width: 0;
}

.cart-item__header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 0.75rem;
}

.cart-item__info {
  flex: 1;
  min-width: 0;
}

.cart-item__title {
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--cart-text-primary);
  text-decoration: none;
  line-height: 1.4;
  display: block;
  margin-bottom: 0.25rem;
  letter-spacing: -0.01em;
  transition: color 0.2s ease;
}

.cart-item__title:hover {
  color: var(--cart-primary);
}

.cart-item__variants {
  display: flex;
  flex-wrap: wrap;
  gap: 0.25rem;
  margin: 0;
}

.cart-item__variant-item {
  font-size: 0.75rem;
  color: var(--cart-text-secondary);
  background: none;
  border: none;
  padding: 0;
}

/* Unit price — top right of item header */
.cart-item__price-main {
  font-size: 0.875rem;
  font-weight: 500;
  color: var(--cart-text-secondary);
  white-space: nowrap;
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  gap: 1px;
}

/* FOOTER: Controls Row */
.cart-item__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.5rem;
}

.cart-item__quantity-group {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

/* Compact the shared quantity-selector component (used theme-wide) to fit a cart row */
cart-quantity-selector-component.cart-item__quantity {
  height: 32px;
  min-width: 96px;
  padding: 0 4px;
}

cart-quantity-selector-component.cart-item__quantity .button {
  width: 24px;
  height: 24px;
}

cart-quantity-selector-component.cart-item__quantity .button svg {
  width: 10px;
  height: 10px;
}

cart-quantity-selector-component.cart-item__quantity input {
  width: 28px;
  font-size: 0.8125rem;
}

.cart-item__line-total {
  font-weight: 700;
  color: var(--cart-text-primary);
  font-size: 0.9375rem;
  white-space: nowrap;
  margin-left: auto;
  display: inline-flex;
  align-items: center;
  gap: 1px;
}

.cart-item__remove {
  color: var(--cart-text-tertiary);
  background: transparent;
  border: none;
  cursor: pointer;
  padding: 6px;
  transition: all 0.2s ease;
  line-height: 1;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 6px;
}

.cart-item__remove:hover {
  color: var(--cart-red);
  background: var(--cart-red-light);
  transform: scale(1.05);
}

/* ==========================================
   ERROR MESSAGE
   ========================================== */

.cart-item__error {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.6rem 0.75rem;
  background: var(--cart-red-light);
  border: 1px solid rgba(211, 47, 47, 0.2);
  border-radius: 4px;
  font-size: 0.75rem;
  color: var(--cart-red);
  line-height: 1.4;
  margin-top: 0.5rem;
  animation: slideDown 0.25s ease;
}

.cart-item__error.hidden {
  display: none;
}

@keyframes slideDown {
  from {
    opacity: 0;
    transform: translateY(-8px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ==========================================
   MOBILE RESPONSIVE
   ========================================== */

@media screen and (max-width: 749px) {
  .cart-item {
    padding: 0.875rem 0.75rem;
    gap: 0.75rem;
  }

  .cart-item__image-wrapper {
    width: 75px;
    height: 75px;
  }

  .cart-item__title {
    font-size: 0.875rem;
  }

  .cart-item__variant-item {
    font-size: 0.75rem;
  }

  .cart-item__price-main {
    font-size: 0.9375rem;
  }

  .cart-item__line-total {
    font-size: 0.9375rem;
  }

  .modern-cart-header {
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .modern-cart-title {
    font-size: 1.5rem;
  }
}

@media screen and (max-width: 480px) {
  .cart-item {
    gap: 0.5rem;
    padding: 0.75rem 0.625rem;
    flex-wrap: wrap;
  }

  .cart-item__image-wrapper {
    width: 70px;
    height: 70px;
  }

  .cart-item__header {
    width: 100%;
    flex-basis: 100%;
    gap: 0.5rem;
  }

  .cart-item__title {
    font-size: 0.8125rem;
  }

  .cart-item__footer {
    width: 100%;
    flex-basis: 100%;
  }

  .cart-empty-state {
    padding: 2.5rem 1rem 3rem;
    min-height: 400px;
  }

  .cart-empty-icon-circle {
    width: 110px;
    height: 110px;
  }

  .cart-empty-icon-svg {
    width: 44px;
    height: 44px;
  }

  .cart-empty-heading {
    font-size: 1.75rem;
  }

  .cart-empty-text {
    font-size: 0.9375rem;
  }

  .modern-cart-count {
    font-size: 0.75rem;
  }
}

/* ==========================================
   ACCESSIBILITY
   ========================================== */

.visually-hidden {
  position: absolute !important;
  width: 1px !important;
  height: 1px !important;
  padding: 0 !important;
  margin: -1px !important;
  overflow: hidden !important;
  clip: rect(0, 0, 0, 0) !important;
  white-space: nowrap !important;
  border: 0 !important;
}

.cart-item__remove:focus-visible,
.cart-item__title:focus-visible,
.cart-empty-button:focus-visible {
  outline: 2px solid var(--cart-primary);
  outline-offset: 2px;
}

@media (prefers-reduced-motion: reduce) {
  * {
    animation: none !important;
    transition: none !important;
  }
}
</style>
